{
  "name": "taox-todo",
  "version": "1.0.0",
  "description": "在笔记中以 ```todo 代码块内嵌交互式待办列表，支持分组与子组、优先级、创建/完成日期、拖拽排序、内联编辑与全文搜索，数据以 JSON 保存在代码块内。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "todo"
  ],
  "author": "cata",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "obsidian": "^1.14.4",
    "sass": "^1.108.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  }
}
